# Explorer API (Etherscan or compatible)
EXPLORER_API_KEY=
EXPLORER_API_URL=https://api.etherscan.io/api

# The Graph — API key for the decentralized network gateway
GRAPH_API_KEY=

# The Graph Network registry endpoint (decentralized, not hosted)
# Used to discover subgraphs by contract address match
GRAPH_NETWORK_URL=

# Top-N subgraphs by queryFeesAmount to use as evidence sources (default 3)
TOP_SUBGRAPHS_FOR_STATISTICS=3

# Max records to fetch per entity per subgraph (default 25)
GRAPH_QUERY_MAX_ITEMS=25

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Local server port (optional, default 3000)
PORT=3000
